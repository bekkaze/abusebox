# JWT signing secret. Leave empty to auto-generate one (saved next to the
# SQLite database as .secret_key). Set it to share sessions across machines.
APP_SECRET_KEY=
# Show detailed error tracebacks (local development only)
APP_DEBUG=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Hostnames the frontend dev server answers to (Docker). Add your server's
# domain or IP when opening AbuseBox from another machine.
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite default value (works out of the box). Ignored by docker-compose,
# which always stores the database in the persistent volume.
DATABASE_URL=sqlite:///./app.db

# Seeded admin user (only used the first time the database is created —
# change the password afterwards in Settings)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=password123
DEFAULT_ADMIN_EMAIL=admin@abusebox.local
DEFAULT_ADMIN_PHONE=11111111

# AbuseIPDB (get a free key at https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# Scheduled monitoring (re-checks monitored hostnames periodically)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=360

# Email alerts (optional — sends when a hostname gets blacklisted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Webhook alerts (optional — POSTs JSON when a hostname gets blacklisted)
WEBHOOK_URL=
