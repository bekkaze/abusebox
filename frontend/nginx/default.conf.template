# Rendered at container start: ${BACKEND_URL} comes from the environment.
server {
    listen 3000;
    listen [::]:3000;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # DMARC and target-list uploads are capped at 10 MB by the backend.
    client_max_body_size 12m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The API, on the same origin as the UI. The prefix is stripped; the
    # backend uses X-Forwarded-Prefix only to link its API docs correctly,
    # and X-Forwarded-For to rate limit per client.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;
        # Bulk checks of 300 targets can take minutes.
        proxy_read_timeout 300s;
    }

    # Built files have content hashes in their names, so they never change.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes all load the single-page app.
    location / {
        try_files $uri /index.html;
    }
}
